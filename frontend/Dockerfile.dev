# Development image for the HiQNet POS frontend (Vite dev server with HMR).
#
# The version used is pinned by package.json "packageManager" via Corepack, so
# it always matches CI and the lockfile.
FROM node:24-alpine

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

EXPOSE 5173

CMD ["pnpm", "dev", "--host", "0.0.0.0", "--port", "5173"]

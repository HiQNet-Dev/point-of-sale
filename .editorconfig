# EditorConfig: consistent encoding, indentation and line endings.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,kt}]
indent_style = tab
indent_size = 4

[*.{ts,tsx,js,jsx,json,yml,yaml,html,css,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
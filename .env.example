# Local development environment variables for docker-compose.yml.
# Safe example values only — never put real credentials here.
POSTGRES_DB=hiqnet_pos
POSTGRES_USER=hiqnet_dev
POSTGRES_PASSWORD=hiqnet_dev_only
POSTGRES_PORT=5432

# Backend signature secret for JWT access tokens (HS256).
# Base64-encoded key; when decoded it must be >= 32 bytes (256 bits).
# No default: the app refuses to start without it. Generate with:
#   openssl rand -base64 32
# Keep it secret and unique per environment.
AUTH_JWT_SECRET=

# One-shot deployment secret for the FIRST-RUN provisioning (POST
# /api/v1/bootstrap). Base64-encoded; when decoded it must be >= 32 bytes.
# TEMPORARY: only needed for the initial provisioning. Remove it and restart
# after bootstrap. Never a default value; distinct from AUTH_JWT_SECRET.
# Generate with:
#   openssl rand -base64 32
BOOTSTRAP_SECRET=
# Local development environment variables for docker-compose.yml and the
# development seed/reset scripts (frontend/scripts/dev/).
#
# Safe example values only — never put real credentials here. Copy to `.env`
# (gitignored) and adjust if needed:
#   cp .env.example .env
#
# Everything below is DEVELOPMENT ONLY and intentionally insecure.

# --- Development safety guard (required by `pnpm dev:seed` / `pnpm dev:reset`) ---
# Must be exactly "development"; any other value makes the scripts refuse to run.
APP_ENV=development
# Spring profile for the backend container. Default is already `dev`.
SPRING_PROFILES_ACTIVE=dev

# --- PostgreSQL (Compose `db` service) ---
POSTGRES_DB=hiqnet_pos
POSTGRES_USER=hiqnet_dev
POSTGRES_PASSWORD=hiqnet_dev_only
POSTGRES_PORT=5432

# --- Published service ports ---
SERVER_PORT=8080
VITE_PORT=5173

# --- Backend ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Development-only signing key (Base64, >= 32 bytes decoded).
# Generate your own for anything that is not a throwaway local stack:
#   openssl rand -base64 32
AUTH_JWT_SECRET=aGlxbmV0LXBvcy1kZXYtb25seS1qd3Qtc2lnbmluZy1zZWNyZXQtMDE=
# One-shot secret for the first-run provisioning (POST /api/v1/bootstrap).
# Development-only value; in production it is provided per environment and
# removed after provisioning.
BOOTSTRAP_SECRET=aGlxbmV0LXBvcy1kZXYtb25seS1ib290c3RyYXAtc2VjcmV0LTAx

# --- Frontend ---
# Browser-facing backend URL (the SPA runs in the host browser).
VITE_API_BASE_URL=http://localhost:8080/api/v1
# Set to "true" on Windows + Docker Desktop if Vite misses bind-mounted changes.
VITE_USE_POLLING=false

# --- Development fixtures (seed/reset) — fictitious, DEVELOPMENT ONLY accounts ---
DEV_API_URL=http://localhost:8080/api/v1
DEV_ORGANIZATION_CODE=pos-dev
DEV_ORGANIZATION_NAME=HiQNet POS Development
DEV_ADMIN_EMAIL=admin@hiqnet.local
DEV_ADMIN_PASSWORD=admin-dev-only
DEV_MANAGER_EMAIL=manager@hiqnet.local
DEV_CASHIER_EMAIL=cashier@hiqnet.local
DEV_STAFF_PASSWORD=staff-dev-only
